\ProvidesPackage{config/presentationgray}
\mode<presentation>

% removing navigation symbols
\setbeamertemplate{navigation symbols}{}

% packages
\usepackage{xcolor}
\usepackage{fontspec}
\usepackage{setspace}
\usepackage{tikz}
\usepackage{enumitem}
\usepackage{caption}
\usepackage{textpos}

% colors
\definecolor{inriared}{RGB}{230,51,18}
\definecolor{colorblack}{RGB}{0,0,0}
\definecolor{inriagray}{RGB}{56,66,87} % heavy dark gray for normal text
\definecolor{colorlgray}{HTML}{FAFAFA} % background light gray

% font sizes
\newcommand{\fontsizeone}{2.292em}
\newcommand{\fontsizeon}{1.826em}
\newcommand{\fontsizetwo}{1.217em}
\newcommand{\fontsizetw}{1.027em}
\newcommand{\fontsizethree}{0.875em}
\newcommand{\fontsizethre}{0.725em}
% line spaces
\newcommand{\linespaceone}{1}

% font families
\newfontfamily{\montserratfont}[Path=fonts/,BoldFont=Montserrat-Bold]{Montserrat-Regular}
\newfontfamily{\notosansfont}[Path=fonts/,BoldFont=NotoSans-Bold,ItalicFont=NotoSans-Italic,BoldItalicFont=NotoSans-BoldItalic,SmallCapsFont=AlegreyaSansSC-Regular]{NotoSans-Regular}
\newfontfamily{\latolightfont}[Path=fonts/]{Lato-Lig}
\newfontfamily{\inconsolatafont}[Path=fonts/]{Inconsolata}

% beamer template changes
\setbeamertemplate{frametitle}{ \vspace{0.40em}
\noindent
\hspace{-1.22em}
\tikz[overlay,remember picture,baseline=0.3em]{\fill[fill=inriagray]  (-0.3,0.05) rectangle (0,0.9); }\montserratfont\color{inriagray}~~\insertframetitle%
}


\setmainfont[Ligatures=TeX,Path=fonts/,BoldFont=NotoSans-Bold,ItalicFont=NotoSans-Italic,BoldItalicFont=NotoSans-BoldItalic,SmallCapsFont=AlegreyaSansSC-Regular]{NotoSans-Regular}
\setsansfont[Ligatures=TeX,Path=fonts/,BoldFont=NotoSans-Bold,ItalicFont=NotoSans-Italic,BoldItalicFont=NotoSans-BoldItalic,SmallCapsFont=AlegreyaSansSC-Regular]{NotoSans-Regular}
\setmonofont[Ligatures=TeX,Path=fonts/,SmallCapsFont=AlegreyaSansSC-Regular]{Inconsolata}

% frame counter
\newcounter{totalfr}
\setbeamertemplate{footline}{
\ifnum\inserttotalframenumber=1
\setcounter{totalfr}{2}
\else
\setcounter{totalfr}{\inserttotalframenumber}
\fi
\hfill{
\tikz{
\filldraw[fill=inriagray!20, draw=inriagray!60]  (0,0) -- (0.2,0) arc (0:{\value{framenumber}*(360/(\value{totalfr}-1))}:0.2) -- (0,0);
\node at (0,0) {\normalsize \color{inriagray}\scriptsize{\textbf\insertframenumber}};
}}
\hspace{2em}
\vspace*{1em}}
\addtocounter{framenumber}{-1} % Decrease the framenumber counter by 1

% custom commands
\newcommand{\Hugetext}[1]{{
\begin{spacing}{\linespaceone}
\fontsize{\fontsizeone}{\fontsizeone}{\montserratfont #1}
\end{spacing}}}

\newcommand{\hugetext}[1]{{
\begin{spacing}{\linespaceone}
\fontsize{\fontsizeon}{\fontsizeon}{\montserratfont #1}
\end{spacing}}}

\newcommand{\Largetext}[1]{{\fontsize{\fontsizethree}{\fontsizethree}\selectfont{#1}}}

\newcommand{\largetext}[1]{{\fontsize{\fontsizethre}{\fontsizethre}\selectfont{#1}}}

\newcommand{\setnote}[1]{{\fontsize{\fontsizethree}{\fontsizeone}\selectfont\color{inriagray}{#1}}}

\newcommand{\framecard}[2][inriagray]{{\setbeamercolor{background canvas}{bg=#1}
\begin{frame}[plain]
\begin{center}
\vfill
\color{colorlgray}
{#2}
\vfill
\end{center}
\end{frame}}}

\newcommand{\framecontent}[2][inriagray]{{\setbeamercolor{background canvas}{bg=#1}
\begin{frame}[plain]
\color{colorlgray}
{#2}
\end{frame}}}

\newcommand{\framepic}[3][1]{{
\usebackgroundtemplate{%
\tikz[overlay,remember picture] \node[opacity=#1, at=(current page.center)]{\includegraphics[width=\paperwidth]{#2}};
}
\begin{frame}
#3
\end{frame}}}

\def\labelitemi{$\color{inriagray}{\bullet}$}

\newenvironment{baseitemize}
{\itemize[leftmargin=*]}
{\enditemize}

\newenvironment{fullpageitemize}
{\itemize[nolistsep,itemsep=\fill,leftmargin=*, label={$\color{inriagray}{\bullet}$}]}
{\vfill\enditemize}


% Sets the background color to be light gray and the default text color to be heavy dark gray.
% Recommended for presenting with high quality projectors, since the high contrast of black-white is not advisable
\setbeamercolor{background canvas}{bg=colorlgray}
\setbeamercolor{normal text}{fg=colorblack}
\setbeamercolor{title}{fg=inriagray}
\setbeamercolor{subtitle}{fg=inriagray}
\setbeamerfont{subtitle}{family=\montserratfont}
\setbeamercolor{author}{fg=inriagray}
\setbeamercolor{date}{fg=inriagray}
\setbeamercolor{institute}{fg=inriagray}

\defbeamertemplate*{title page}{customized}[1][]
{
\vfill
{\usebeamercolor[fg]{title}\hugetext{\inserttitle}}
{\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\Large{\insertsubtitle}\par}
\vfill
{\usebeamercolor[fg]{author}\largetext{\insertauthor}}\vfill
{\setnote{\insertinstitute}\par}
\vfill
{\usebeamercolor[fg]{colorgreen}\setnote{\insertdate}\par}
\vfill
\begin{tikzpicture}[remember picture,overlay]
\node[anchor=south east,yshift=20pt,xshift=-12pt] (logoinria) at (current page.south east) {\includegraphics[height=0.92cm]{images/inr_logo_gris.png}};
\node[anchor=east] (logoens) at (logoinria.west) {\includegraphics[height=0.95cm]{images/ens-psl.png}};
\end{tikzpicture}
}

